# Generate with: openssl rand -hex 32
FM_API_KEYS=replace-with-generated-api-key
# Optional. Leave empty unless you need admin-only features; set explicitly when used.
FM_ADMIN_API_KEYS=
FM_DASHBOARD_USER=
FM_DASHBOARD_PASSWORD=
FM_SEARXNG_URL=http://searxng:8080
FM_LOG_LEVEL=info

# Reliability budgets (safe defaults shown).
FM_ARTIFACT_CONCURRENCY=3
FM_MAX_REQUEST_SOURCE_BYTES=67108864
FM_MAX_REQUEST_OUTPUT_BYTES=134217728
FM_MEMORY_CACHE_ENTRIES=512
FM_MEMORY_CACHE_BYTES=134217728
FM_CACHE_MAX_VALUE_BYTES=8388608
FM_RATE_LIMIT_PER_SEC=5
FM_RATE_LIMIT_BURST=20

# Required with FM_RENDERER_URL. Compose provides these automatically.
FM_RENDERER_EGRESS_PROXY_URL=http://fetchmark:8081
