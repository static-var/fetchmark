# Generate with: openssl rand -hex 32
FM_API_KEYS=replace-with-generated-api-key
# Optional. Leave empty unless you need admin-only features; set explicitly when used.
FM_ADMIN_API_KEYS=
FM_DASHBOARD_USER=
FM_DASHBOARD_PASSWORD=
FM_SEARXNG_URL=http://searxng:8080
FM_LOG_LEVEL=info

# Reliability budgets (safe defaults shown).
FM_ARTIFACT_CONCURRENCY=3
FM_MAX_REQUEST_SOURCE_BYTES=67108864
FM_MAX_REQUEST_OUTPUT_BYTES=134217728
FM_MEMORY_CACHE_ENTRIES=512
FM_MEMORY_CACHE_BYTES=134217728
FM_CACHE_MAX_VALUE_BYTES=8388608
# Optional local flywheel. disabled is the privacy-preserving default;
# curated/archive additionally require both paths, robots=true, and an admin
# API key. Archive also requires a new empty artifact directory.
FM_LOCAL_CORPUS_MODE=disabled
FM_LOCAL_CORPUS_MAX_AGE=720h
FM_LOCAL_EXPIRY_SWEEP_INTERVAL=15m
FM_LOCAL_INDEX_PATH=
FM_LOCAL_INDEX_MAX_DOCUMENT_BYTES=2097152
FM_LOCAL_INDEX_MAX_BYTES=1073741824
FM_LOCAL_INDEX_MAX_DOCUMENTS=100000
FM_LOCAL_ARTIFACT_PATH=
FM_LOCAL_ARTIFACT_MAX_BYTES=1073741824
FM_LOCAL_ARTIFACT_MAX_VALUE_BYTES=20971520
FM_LOCAL_ARTIFACT_MAX_ENTRIES=100000
FM_LOCAL_ARCHIVE_MAX_VERSIONS=100000
FM_LOCAL_ARCHIVE_MAX_VERSIONS_PER_URL=16
# Optional separate focused-ingestion worker. The key must also be present in
# FM_ADMIN_API_KEYS; never place it in crawler.json.
FM_CRAWLER_ADMIN_API_KEY=
FM_CRAWLER_HTTP_TIMEOUT=90s
FM_DISCOVERY_CACHE_TTL=30s
FM_DISCOVERY_CACHE_STALE_TTL=2m
FM_DISCOVERY_CACHE_ENTRIES=256
FM_DISCOVERY_CACHE_BYTES=16777216
FM_DISCOVERY_CACHE_MAX_ENTRY_BYTES=1048576
FM_DISCOVERY_REFRESH_TIMEOUT=30s
FM_DISCOVERY_MAX_INFLIGHT=16
FM_ADVANCED_SEARCH_CONCURRENCY=4
FM_DISCOVERY_PACK_FILE=
FM_DISCOVERY_ENABLED_PACKS=general-open,developer,research,knowledge,fresh
# Secondary native lanes: append `arxiv`, `mwmbl`, `wiby`, `stackexchange`,
# anonymous metadata-only `github`, metadata-only `pubmed`, an explicitly
# configured operator-controlled `yacy` node, and/or local `feedindex`.
FM_DISCOVERY_ENABLED_SOURCES=scrapling,searxng,wikipedia,crossref
# Scrapling answers first; the remaining open lanes run only when its results
# are empty, degraded, or fail the deterministic lexical confidence check.
FM_DISCOVERY_PRIMARY_SOURCE=scrapling
FM_DISCOVERY_PROVIDER_MAX_BODY=2097152
# Optional absolute path to the trusted publisher/source binding registry.
# It must be process-owned and not group/world writable; open-pack sources
# remain disabled until explicitly added above.
FM_OPEN_PACK_REGISTRY_FILE=
# Required only for feedindex: absolute process-owned RSS/Atom metadata snapshot.
FM_FEED_INDEX_FILE=
# Optional private trusted federation. Both files are required together.
# The identity must be mode 0600. Inbound serving additionally requires
# curated local-corpus mode and a separate TLS/private-ingress listener.
FM_FEDERATION_IDENTITY_FILE=
FM_FEDERATION_TRUST_REGISTRY_FILE=
FM_FEDERATION_LISTEN_ADDR=
# Optional provider/crawler contact identity: email, mailto:, or HTTP(S) URL.
FM_CONTACT=
# Optional. A plain email moves Crossref requests into its polite pool.
FM_CROSSREF_MAILTO=
# Required only when the opt-in native `pubmed` source is enabled. NCBI asks
# distributed E-utilities clients to send a real operator/developer email.
FM_PUBMED_EMAIL=
# Required only when the opt-in `yacy` source is enabled. Bind one explicitly
# trusted operator-controlled origin. `global` discloses queries to YaCy peers;
# plain HTTP must be explicitly acknowledged and kept on a private network.
FM_YACY_URL=
FM_YACY_RESOURCE=local
FM_YACY_ALLOW_INSECURE_HTTP=false

# Compose-private persistent Scrapling discovery/rendering sidecar.
FM_SCRAPLING_URL=http://scrapling:8080
FM_SCRAPLING_ALLOW_INSECURE_HTTP=true
# Optional: name of a configured local/OpenAI-compatible summarizer profile.
FM_COMPAT_ANSWER_PROVIDER=
FM_COMPAT_ANSWER_MAX_TOKENS=512
FM_COMPAT_ANSWER_TIMEOUT=30s
FM_RATE_LIMIT_PER_SEC=5
FM_RATE_LIMIT_BURST=20

# Required with FM_RENDERER_URL. Compose provides these automatically.
FM_RENDERER_URL=http://scrapling:8080/v1/render
FM_RENDERER_AUTO=true
FM_RENDERER_EGRESS_PROXY_URL=http://fetchmark:8081
